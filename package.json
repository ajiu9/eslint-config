{
  "name": "@ajiu9/eslint-config",
  "type": "module",
  "version": "2.5.4",
  "description": "ajiu9's Eslint config",
  "author": "ajiu9 <615944323@qq.com> (https://github.com/ajiu9/)",
  "license": "MIT",
  "keywords": [
    "eslint-config"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./bin/index.js",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "pnpm build",
    "dev": "npx @eslint/config-inspector --config eslint.config.ts",
    "lint": "eslint . --fix",
    "build": "tsup --format esm,cjs --clean --dts",
    "watch": "tsup --format esm,cjs --watch",
    "release": "bumpp && pnpm publish",
    "test": "pnpm build && vitest",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "@prettier/plugin-xml": "^3.4.1",
    "@vue/compiler-sfc": "^3.5.12",
    "eslint": "^9.13.0 || ^10.0.0",
    "eslint-plugin-format": "^2.0.1"
  },
  "peerDependenciesMeta": {
    "@prettier/plugin-xml": {
      "optional": true
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "eslint-config-flat-gitignore": "^2.3.0",
    "eslint-config-taro": "^4.0.9",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-plugin-import-x": "^4.3.1",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-yml": "^3.8.1",
    "globals": "^17.11.0",
    "jsonc-eslint-parser": "^3.3.0",
    "op-pkg": "^0.0.3",
    "vue-eslint-parser": "^10.4.1",
    "yaml-eslint-parser": "^2.1.0"
  },
  "devDependencies": {
    "@ajiu9/eslint-config": "workspace:*",
    "@eslint/config-inspector": "^3.3.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@types/fs-extra": "^11.0.4",
    "@vue/compiler-sfc": "^3.5.12",
    "bumpp": "^12.2.1",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "^2.0.1",
    "execa": "^10.0.1",
    "fs-extra": "^11.2.0",
    "jiti": "^2.3.3",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.11.1",
    "tinyglobby": "^0.2.12",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
